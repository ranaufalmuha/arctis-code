{
  "name": "ArctisCode",
  "source": "ArctisCode Black — pitch-black background, neutral dark-grey cards, no blue-tinted surfaces. Ported manually to egui, no runtime dep",
  "colors": {
    "editorBg": "#000000",
    "editorFg": "#D4D4D4",
    "sideBarBg": "#101010",
    "cardBg": "#101010",
    "activityBarBg": "#000000",
    "tabStripBg": "#101010",
    "tabActiveBg": "#000000",
    "tabInactiveBg": "#161616",
    "text": "#CCCCCC",
    "muted": "#969696",
    "faint": "#6E6E6E",
    "accent": "#007ACC",
    "selection": "#264F78",
    "listHover": "#1A1A1A",
    "listActiveSelection": "#2A2A2A",
    "inputBg": "#161616",
    "buttonBg": "#0E639C",
    "buttonSecondaryBg": "#2D2D2D",
    "buttonSecondaryHover": "#383838",
    "danger": "#F14C4C",
    "warning": "#CCA700"
  },
  "radius": 0,
  "transparency": {
    "note": "Transparent viewport, sharp see-through (no OS blur: vibrancy blanks GL compositing). Explorer panel and status bar have no background; task columns and weak fills use the opaque cardBg.",
    "sideBarBgAlpha": 0.0,
    "listHoverAlpha": 0.8,
    "listActiveSelectionAlpha": 0.9
  },
  "font": { "monoSize": 14, "uiSize": 13, "smallSize": 12 },
  "metrics": {
    "activityBarWidth": 48,
    "tabStripHeight": 35,
    "statusBarHeight": 22,
    "treeRowHeight": 22
  },
  "componentsUsed": ["tabs", "scroll-area", "tooltip", "dialog", "toast", "command", "image"]
}
